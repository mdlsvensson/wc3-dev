---
import { getCollection } from 'astro:content';
import { ArrowUpRight, ArrowRight, Users, Terminal, CodeXml, BookOpen } from 'lucide-astro';
import Portal from '../layouts/Portal.astro';
const resources = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order);
const icons = { Community: Users, Tooling: Terminal, Scripting: CodeXml };
---
<Portal title="Build your next Warcraft III world" description="Tools, communities, and scripting resources for Warcraft III modders. Find your workflow and start building.">
  <section class="hero wrap">
    <div class="eyebrow"><span class="small-rule"></span> THE WARCRAFT III DEVELOPER PORTAL</div>
    <div class="hero-grid"><div><h1>Old game.<br /><span>New possibilities.</span></h1><p class="hero-copy">A home for the people still building worlds.<br class="desktop-break" /> Explore the tools, code, and communities behind Warcraft III modding.</p><a class="button primary" href="#resources">Explore the resources <ArrowRight size={18} /></a></div>
    <div class="hero-emblem"><img src="/brand/wc3-crest.png" alt="wc3.dev shield and crossed swords crest" width="2000" height="2000" fetchpriority="high" /><span>FOR THE WORLD BUILDERS</span></div></div>
    <nav class="field-notes" aria-label="Choose your starting point"><a href="https://www.hiveworkshop.com/"><span class="note-number">01</span><div><h2>Find your people</h2><p>Maps, models, tutorials, and fellow modders.</p></div><ArrowUpRight size={20} /></a><a href="#resources"><span class="note-number">02</span><div><h2>Equip your workflow</h2><p>Tools for the editor and beyond.</p></div><ArrowRight size={20} /></a><a href="/framework/"><span class="note-number">03</span><div><h2>Build with TypeScript</h2><p>A code-first path from idea to playable map.</p></div><ArrowRight size={20} /></a></nav>
    <div class="hero-baseline"><span>WORLD EDITOR / LUA / JASS / TYPESCRIPT</span><span>Made for map makers.</span></div>
  </section>
  <section class="resources-section wrap" id="resources" aria-labelledby="resources-title">
    <div class="section-heading"><div><div class="eyebrow">THE TOOLBOX</div><h2 id="resources-title">Good places to start.</h2></div><p>The foundations of a Warcraft III workflow,<br />from your first trigger to your next release.</p></div>
    <div class="resource-grid">{resources.map(({ data }) => { const Icon = icons[data.category]; return <a class="resource-card" href={data.url}><div class="card-top"><Icon size={23} strokeWidth={1.5} /><span>{data.category}</span><ArrowUpRight size={18} /></div><h3>{data.title}</h3><p>{data.description}</p><span class="card-label">{data.label}</span></a>; })}</div>
  </section>
  <section class="framework-feature wrap"><div class="framework-copy"><div class="eyebrow">SPOTLIGHT / W3TS FRAMEWORK</div><h2>Your editor.<br />Your code. One workflow.</h2><p>Keep terrain in the World Editor. Write gameplay in TypeScript, define objects in Pkl, and let Deno bring it together.</p><a class="text-link" href="/framework/">Meet the framework <ArrowRight size={18} /></a></div><div class="workflow"><div><span>01</span><strong>World Editor</strong><small>Terrain & placements</small></div><div><span>02</span><strong>TypeScript + Pkl</strong><small>Gameplay & object data</small></div><div><span>03</span><strong>Your playable map</strong><small>Built with Deno</small></div><a href="/framework/docs/"><BookOpen size={17} /> Read the documentation <ArrowRight size={17} /></a></div></section>
</Portal>
