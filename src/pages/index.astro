---
import { ArrowUpRight, BookOpen, FileCode } from 'lucide-astro';
import Shell from '../layouts/Shell.astro';
import GuideNav from '../components/GuideNav.astro';
import ResourceDirectory from '../components/ResourceDirectory.astro';
import HiveCard from '../components/hive/HiveCard.astro';
import { getLinks } from '../lib/resources';
import '../styles/home.css';
import '../styles/hive.css';
const resources = await getLinks();
---
<Shell title="Modding resources" description="Warcraft III modding resources, scripting tools, and framework documentation.">
  <GuideNav slot="side" />
  <div class="portal-workspace wrap">
    <div class="workspace-heading"><h1>Old game. <span>New tricks.</span></h1><p>Warcraft III modding resources and documentation.</p></div>
    <div class="workspace-columns">
      <ResourceDirectory resources={resources} title="Resources" id="resources" />
      <div class="workspace-side">
        <aside class="framework-reference" aria-labelledby="framework-title">
          <header class="workspace-panel-heading"><h2 id="framework-title"><FileCode size={18} /> wc3.dev-framework</h2><span class="version-label">Alpha</span></header>
          <p class="reference-description">TypeScript gameplay, Pkl object data, and Deno build tools.</p>
          <div class="reference-actions"><a class="button primary" href="/framework/docs/" data-astro-reload><BookOpen size={16} /> Documentation</a><a class="button secondary" href="/framework/">Overview</a></div>
          <a class="reference-source" href="https://github.com/mdlsvensson/wc3-dev-framework">Source repository <ArrowUpRight size={16} /></a>
        </aside>
        <HiveCard />
      </div>
    </div>
  </div>
</Shell>
