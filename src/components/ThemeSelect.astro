---
---

<label class="mw-palette-picker">
  <span class="sr-only">Theme</span>
  <select data-palette-select aria-label="Theme">
    <option value="kanagawa-wave">Kanagawa Wave</option>
    <option value="vitesse-dark">Vitesse Dark</option>
  </select>
</label>

<script is:inline>
  (() => {
    const current = document.documentElement.dataset.palette || "kanagawa-wave";
    document.querySelectorAll("select[data-palette-select]").forEach((select) => {
      if (!(select instanceof HTMLSelectElement)) return;
      select.value = current;
      if (select.dataset.bound === "true") return;
      select.dataset.bound = "true";
      select.addEventListener("change", (event) => {
        const target = event.currentTarget;
        if (!(target instanceof HTMLSelectElement)) return;
        const next = target.value === "vitesse-dark" ? "vitesse-dark" : "kanagawa-wave";
        document.documentElement.dataset.palette = next;
        try {
          localStorage.setItem("wc3-dev-palette", next);
        } catch {}
        if (window.StarlightThemeProvider) {
          window.StarlightThemeProvider.updatePickers(next);
        }
      });
    });
  })();
</script>
