---
const currentYear = new Date().getFullYear();
---

<footer class="app-footer">
  <span>wc3.dev is an independent modding resource.</span>
  <span>Warcraft III is &copy;{currentYear} Blizzard Entertainment, Inc.</span>
</footer>

<style>
  .app-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--app-footer-height);
    padding: .35rem max(1rem, calc((100vw - 1180px) / 2));
    border-top: 1px solid #685a2a;
    background: #101a20;
    color: #aebbc1;
    font-size: .7rem;
    line-height: 1.35;
  }
  span { min-width: 0; }
  span:last-child { text-align: right; }
  @media (max-width: 620px) {
    span { max-width: 50%; }
  }
  @media print { .app-footer { height: auto; } }
</style>
