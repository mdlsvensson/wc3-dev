---
import { getCollection } from "astro:content";
import { CardGrid, LinkCard } from "@astrojs/starlight/components";

const entries = await getCollection("docs");
const patches = entries
  .filter((entry) => entry.id !== "index" && entry.id !== "404")
  .sort((a, b) => b.id.localeCompare(a.id, undefined, { numeric: true, sensitivity: "base" }));
---

<CardGrid>
  {
    patches.map((patch) => (
      <LinkCard
        title={patch.data.title}
        description={
          patch.data.description ?? `Warcraft III: Reforged release notes for version ${patch.id}.`
        }
        href={`/patch-notes/${patch.id}/`}
      />
    ))
  }
</CardGrid>
