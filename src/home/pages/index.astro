---
import { BookOpen, CodeXml, Compass, Rocket } from "@lucide/astro";
import HomeLayout from "../components/HomeLayout.astro";

const moonwellLinks = [
  {
    title: "Getting Started",
    description: "Install the template and CLI, make a map, and run it in Warcraft III.",
    href: "https://docs.wc3.dev/guides/getting-started/",
  },
  {
    title: "Project & World Editor",
    description:
      "Project folders, map settings, custom assets, and saving built objects back to World Editor.",
    href: "https://docs.wc3.dev/guides/project-and-editor/",
  },
  {
    title: "Objects",
    description:
      "Declare units, heroes, items, abilities, buffs, destructables, doodads, and upgrades as C# classes.",
    href: "https://docs.wc3.dev/guides/objects/",
  },
  {
    title: "Actors, Components & Reactions",
    description:
      "Attach state and reaction hooks to units, items, destructables, players, and the game.",
    href: "https://docs.wc3.dev/guides/components-and-reactions/",
  },
  {
    title: "Abilities, Buffs & Timers",
    description:
      "React to casts, apply timed and ticking buffs, schedule timers, and manage ownership.",
    href: "https://docs.wc3.dev/guides/abilities-buffs-and-timers/",
  },
  {
    title: "Multiplayer",
    description: "Run machine-local code with Local.For and catch desyncs as compile errors.",
    href: "https://docs.wc3.dev/guides/multiplayer/",
  },
  {
    title: "CLI & Build",
    description:
      "Commands, flags, build pipeline steps, development vs. release builds, and error logs.",
    href: "https://docs.wc3.dev/reference/cli-and-build/",
  },
  {
    title: "Runtime & Objects Reference",
    description:
      "All public types, properties, methods, reaction hooks, standard objects, and diagnostics.",
    href: "https://docs.wc3.dev/reference/runtime-api/",
  },
];

const tutorialChapters = [
  {
    title: "1. Editor Basics",
    description:
      "Launch the World Editor, tour the main window, and create and test your 96 × 96 map.",
    href: "/tutorials/editor-basics/install-and-open/",
  },
  {
    title: "2. Terraining",
    description:
      "Paint tiles, raise the village plateau, carve the river, and add paths and trees.",
    href: "/tutorials/terrain/painting-tiles/",
  },
  {
    title: "3. Placing Units & Doodads",
    description:
      "Furnish the village, place defenders and buildings, add creep camps, and draw regions.",
    href: "/tutorials/placement/doodads/",
  },
  {
    title: "4. Map Setup",
    description: "Configure the map description, loading screen, players, and forces.",
    href: "/tutorials/map-setup/map-options/",
  },
  {
    title: "5. Object Editor",
    description: "Create a custom hero, a custom ability, and a village guard tower.",
    href: "/tutorials/object-editor/object-editor-tour/",
  },
  {
    title: "6. GUI Triggers",
    description:
      "Build the wave timer, spawn five waves of attackers, and add win and defeat conditions.",
    href: "/tutorials/triggers/trigger-basics/",
  },
];
---

<HomeLayout title="wc3.dev — Warcraft III: Reforged Modding, Moonwell & Tutorials">
  <main id="main-content" class="mw-home-main">
    <section class="mw-hero">
      <div class="mw-hero-art">
        <img
          src="/mw.gif"
          alt="A moonwell"
          width="256"
          height="256"
          class="mw-hero-image"
        />
      </div>
      <div class="mw-hero-copy">
        <h1 class="mw-hero-title">Warcraft III: Reforged Modding</h1>
        <p class="mw-hero-tagline">
          All-in-one modding framework for Warcraft III: Reforged — plus a step-by-step World Editor track for beginners
        </p>
        <div class="mw-hero-actions">
          <a href="/moonwell/" class="mw-btn mw-btn-primary">
            Explore Moonwell
          </a>
          <a href="/tutorials/" class="mw-btn mw-btn-secondary">
            World Editor Tutorials
          </a>
        </div>
      </div>
    </section>

    <section class="mw-pillars" aria-label="Modding Tracks">
      <article class="mw-pillar-card">
        <div class="mw-pillar-header">
          <span class="mw-pillar-eyebrow">
            <CodeXml size={15} aria-hidden="true" />
            <span>C# Framework &amp; Toolchain</span>
          </span>
          <h2 class="mw-pillar-title">Moonwell</h2>
          <p class="mw-pillar-description">
            Build Warcraft III maps in C#. Declare units, heroes, items, abilities, buffs, and upgrades in code, attach components and reactions to game events, and pack a playable <code>.w3x</code> with <code>moonwell build</code>.
          </p>
          <div class="mw-hero-actions">
            <a
              href="https://docs.wc3.dev/guides/getting-started/"
              class="mw-btn mw-btn-primary"
            >
              <Rocket size={16} aria-hidden="true" />
              <span>Get Started</span>
            </a>
            <a href="https://docs.wc3.dev/" class="mw-btn mw-btn-secondary">
              <BookOpen size={16} aria-hidden="true" />
              <span>Documentation</span>
            </a>
          </div>
        </div>
        <div class="mw-pillar-links">
          {
            moonwellLinks.map((card) => (
              <a href={card.href} class="sl-link-card mw-home-card">
                <span class="title">{card.title}</span>
                <span class="description">{card.description}</span>
              </a>
            ))
          }
        </div>
      </article>

      <article class="mw-pillar-card">
        <div class="mw-pillar-header">
          <span class="mw-pillar-eyebrow">
            <Compass size={15} aria-hidden="true" />
            <span>Beginner Track · 21 Lessons</span>
          </span>
          <h2 class="mw-pillar-title">World Editor Tutorials</h2>
          <p class="mw-pillar-description">
            New to Warcraft III map-making? Build a complete custom map, <strong>Defend the Village</strong>, from an empty grass field to a playable five-wave defense game using the World Editor — no programming required.
          </p>
          <div class="mw-hero-actions">
            <a
              href="/tutorials/editor-basics/install-and-open/"
              class="mw-btn mw-btn-primary"
            >
              <Compass size={16} aria-hidden="true" />
              <span>Start Lesson 1</span>
            </a>
            <a href="/tutorials/" class="mw-btn mw-btn-secondary">
              <BookOpen size={16} aria-hidden="true" />
              <span>All Chapters</span>
            </a>
          </div>
        </div>
        <div class="mw-pillar-links">
          {
            tutorialChapters.map((chapter) => (
              <a href={chapter.href} class="sl-link-card mw-home-card">
                <span class="title">{chapter.title}</span>
                <span class="description">{chapter.description}</span>
              </a>
            ))
          }
        </div>
      </article>
    </section>
  </main>
</HomeLayout>
