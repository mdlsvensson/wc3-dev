---
import {
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Boxes,
  Compass,
  Copy,
  FolderOpen,
  Rocket,
  Sparkles,
  Terminal,
  Users,
  Workflow,
} from "@lucide/astro";
import { getPatchVersions } from "../../patch-notes/versions.mjs";
import HomeLayout from "../components/HomeLayout.astro";

const patchVersions = getPatchVersions();
const latestPatch = patchVersions[0] ?? "3.0.1";
const recentPatchesLabel = patchVersions.slice(0, 2).join(", ");

const moonwellModules = [
  {
    title: "Getting Started",
    meta: "Install & first map",
    href: "https://docs.wc3.dev/guides/getting-started/",
    icon: Rocket,
  },
  {
    title: "Objects",
    meta: "Units, items, abilities",
    href: "https://docs.wc3.dev/guides/objects/",
    icon: Boxes,
  },
  {
    title: "Components & Reactions",
    meta: "State & event hooks",
    href: "https://docs.wc3.dev/guides/components-and-reactions/",
    icon: Workflow,
  },
  {
    title: "Abilities, Buffs & Timers",
    meta: "Casts, ticks & timers",
    href: "https://docs.wc3.dev/guides/abilities-buffs-and-timers/",
    icon: Sparkles,
  },
  {
    title: "Multiplayer",
    meta: "Local.For & desync safety",
    href: "https://docs.wc3.dev/guides/multiplayer/",
    icon: Users,
  },
  {
    title: "Runtime API",
    meta: "Types, hooks & catalog",
    href: "https://docs.wc3.dev/reference/runtime-api/",
    icon: BookOpen,
  },
];

const tutorialChapters = [
  {
    num: "01",
    title: "Editor Basics",
    meta: "3 lessons",
    href: "/tutorials/editor-basics/install-and-open/",
  },
  {
    num: "02",
    title: "Terrain",
    meta: "4 lessons",
    href: "/tutorials/terrain/painting-tiles/",
  },
  {
    num: "03",
    title: "Placement",
    meta: "4 lessons",
    href: "/tutorials/placement/doodads/",
  },
  {
    num: "04",
    title: "Map Setup",
    meta: "2 lessons",
    href: "/tutorials/map-setup/map-options/",
  },
  {
    num: "05",
    title: "Object Editor",
    meta: "4 lessons",
    href: "/tutorials/object-editor/object-editor-tour/",
  },
  {
    num: "06",
    title: "Triggers",
    meta: "4 lessons",
    href: "/tutorials/triggers/trigger-basics/",
  },
];
---

<HomeLayout title="wc3.dev — Warcraft III: Reforged Modding & Tutorials">
  <main id="main-content" class="mw-home-main mw-dashboard-main">
    <section class="mw-cmd-bar" aria-label="Control Center Header">
      <div class="mw-cmd-identity">
        <h1 class="mw-cmd-title">Warcraft III: Reforged Modding Portal</h1>
        <p class="mw-cmd-subtitle">
          C# map framework, World Editor tutorials, patch notes &amp; engine reference
        </p>
      </div>
      <div class="mw-cmd-telemetry" aria-label="Ecosystem Telemetry">
        <a href="/patch-notes/" class="mw-telemetry-badge">
          <span class="mw-status-dot" aria-hidden="true"></span>
          <span class="mw-telemetry-label">WC3 Patch</span>
          <strong class="mw-telemetry-value">{latestPatch}</strong>
        </a>
        <div class="mw-telemetry-badge">
          <span class="mw-telemetry-label">Moonwell</span>
          <strong class="mw-telemetry-value">v0.1.0</strong>
        </div>
        <div class="mw-telemetry-badge">
          <span class="mw-telemetry-label">Target</span>
          <strong class="mw-telemetry-value">.NET 10 → Lua 5.3</strong>
        </div>
      </div>
    </section>

    <div class="mw-dashboard">
      <section
        class="mw-panel mw-panel-moonwell"
        data-card="moonwell"
        aria-labelledby="panel-moonwell-title"
      >
        <header class="mw-card-head">
          <h2 id="panel-moonwell-title" class="mw-panel-title">Moonwell</h2>
          <div class="mw-card-corner">
            <a href="/moonwell/" class="mw-btn mw-btn-secondary">
              <span>Explore</span>
            </a>
            <a href="https://docs.wc3.dev/" class="mw-btn mw-btn-secondary">
              <span>Docs</span>
            </a>
            <a
              href="https://docs.wc3.dev/guides/getting-started/"
              class="mw-btn mw-btn-primary"
            >
              <span>Get Started</span>
              <ArrowRight size={13} aria-hidden="true" />
            </a>
          </div>
          <small class="mw-card-subtitle">
            C# framework &amp; toolchain · Declare units, abilities, buffs, and items in code and
            pack a playable <code>.w3x</code> with <code>moonwell build</code>
          </small>
        </header>

        <div class="mw-module-grid">
          {
            moonwellModules.map((mod) => {
              const Icon = mod.icon;
              return (
                <a href={mod.href} class="mw-module-card">
                  <Icon size={16} class="mw-module-icon" aria-hidden="true" />
                  <span class="mw-module-copy">
                    <span class="mw-module-title">{mod.title}</span>
                    <span class="mw-module-meta">{mod.meta}</span>
                  </span>
                </a>
              );
            })
          }
        </div>
      </section>

      <section
        class="mw-panel mw-panel-terminal"
        data-card="quickstart"
        aria-labelledby="panel-cli-title"
      >
        <header class="mw-card-head">
          <h2 id="panel-cli-title" class="mw-panel-title">CLI Quickstart</h2>
          <div class="mw-card-corner">
            <button
              type="button"
              class="mw-btn mw-btn-secondary"
              data-copy-cli
              aria-label="Copy CLI quickstart commands"
            >
              <Copy size={12} aria-hidden="true" />
              <span data-copy-label>Copy</span>
            </button>
            <a
              href="https://docs.wc3.dev/reference/cli-and-build/"
              class="mw-btn mw-btn-secondary"
            >
              <span>CLI &amp; Build</span>
              <ArrowRight size={13} aria-hidden="true" />
            </a>
          </div>
          <small class="mw-card-subtitle">
            Install the CLI and template from NuGet to scaffold and compile a map project
          </small>
        </header>

        <div class="mw-terminal-window">
          <div class="mw-terminal-header" aria-hidden="true">
            <span class="mw-term-dot mw-term-dot-red"></span>
            <span class="mw-term-dot mw-term-dot-amber"></span>
            <span class="mw-term-dot mw-term-dot-green"></span>
            <span class="mw-term-caption">shell</span>
          </div>
          <pre
            class="mw-terminal-pre"><code><span class="mw-term-comment"># Install CLI tool &amp; project template</span>
<span class="mw-term-prompt">$</span> dotnet tool install -g Moonwell.Cli
<span class="mw-term-prompt">$</span> dotnet new install Moonwell.Templates

<span class="mw-term-comment"># Create and pack a playable .w3x map</span>
<span class="mw-term-prompt">$</span> dotnet new moonwell -n MyMap
<span class="mw-term-prompt">$</span> cd MyMap &amp;&amp; moonwell build</code></pre>
        </div>

        <div class="mw-panel-links-inline">
          <a
            href="https://docs.wc3.dev/reference/cli-and-build/"
            class="mw-inline-link"
          >
            <Terminal size={13} aria-hidden="true" />
            <span>Build Pipeline</span>
          </a>
          <a
            href="https://docs.wc3.dev/guides/project-and-editor/"
            class="mw-inline-link"
          >
            <FolderOpen size={13} aria-hidden="true" />
            <span>World Editor Sync</span>
          </a>
        </div>
      </section>

      <section
        class="mw-panel mw-panel-tutorials"
        data-card="tutorials"
        aria-labelledby="panel-tutorials-title"
      >
        <header class="mw-card-head">
          <h2 id="panel-tutorials-title" class="mw-panel-title">
            World Editor Tutorials
          </h2>
          <div class="mw-card-corner">
            <a href="/tutorials/" class="mw-btn mw-btn-secondary">
              <span>All Chapters</span>
            </a>
            <a
              href="/tutorials/editor-basics/install-and-open/"
              class="mw-btn mw-btn-primary"
            >
              <Compass size={13} aria-hidden="true" />
              <span>Start Lesson 1</span>
            </a>
          </div>
          <small class="mw-card-subtitle">
            Build <strong>Defend the Village</strong> across 6 chapters and 21 step-by-step lessons
            — no programming required
          </small>
        </header>

        <div class="mw-chapter-grid">
          {
            tutorialChapters.map((ch) => (
              <a href={ch.href} class="mw-chapter-card">
                <span class="mw-chapter-num">{ch.num}</span>
                <span class="mw-chapter-copy">
                  <span class="mw-chapter-title">{ch.title}</span>
                  <span class="mw-chapter-meta">{ch.meta}</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <div class="mw-panel-stack">
        <section
          class="mw-panel mw-panel-compact"
          data-card="engine"
          aria-labelledby="panel-engine-title"
        >
          <header class="mw-card-head">
            <h2 id="panel-engine-title" class="mw-panel-subtitle">
              Engine &amp; Patch Notes
            </h2>
            <div class="mw-card-corner">
              <a href="/patch-notes/" class="mw-btn mw-btn-secondary">
                <span>WC3 {latestPatch}</span>
                <ArrowRight size={12} aria-hidden="true" />
              </a>
            </div>
            <small class="mw-card-subtitle">
              Version history, natives &amp; compiler checks
            </small>
          </header>
          <div class="mw-resource-list">
            <a href="/patch-notes/" class="mw-resource-row">
              <span class="mw-resource-name">
                <span>Warcraft III Patch Notes</span>
                <span class="mw-row-tag mw-row-tag-green">Latest</span>
              </span>
              <span class="mw-resource-detail">
                Patch {recentPatchesLabel} &amp; balance history
              </span>
            </a>
            <a
              href="https://docs.wc3.dev/reference/objects-and-natives/"
              class="mw-resource-row"
            >
              <span class="mw-resource-name">
                <span>Objects, Handles &amp; Natives</span>
                <span class="mw-row-tag mw-row-tag-gold">API</span>
              </span>
              <span class="mw-resource-detail">
                FourCCs, standard catalog &amp; handle types
              </span>
            </a>
            <a
              href="https://docs.wc3.dev/reference/diagnostics/"
              class="mw-resource-row"
            >
              <span class="mw-resource-name">
                <span>Compiler &amp; Build Diagnostics</span>
                <span class="mw-row-tag mw-row-tag-blue">Roslyn</span>
              </span>
              <span class="mw-resource-detail">
                Desync &amp; World Editor limit analyzers
              </span>
            </a>
          </div>
        </section>

        <section
          class="mw-panel mw-panel-compact"
          data-card="toolchain"
          aria-labelledby="panel-toolchain-title"
        >
          <header class="mw-card-head">
            <h2 id="panel-toolchain-title" class="mw-panel-subtitle">
              Repositories &amp; Packages
            </h2>
            <div class="mw-card-corner">
              <span class="mw-panel-meta">Open Source</span>
            </div>
            <small class="mw-card-subtitle">
              C# framework, map formats &amp; Lua transpiler
            </small>
          </header>
          <div class="mw-resource-list">
            <a
              href="https://github.com/mdlsvensson/moonwell"
              class="mw-resource-row"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="mw-resource-name">
                <span>mdlsvensson/moonwell</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </span>
              <span class="mw-resource-detail">
                Framework, CLI, source generators &amp; runtime
              </span>
            </a>
            <a
              href="https://github.com/Drake53/War3Net"
              class="mw-resource-row"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="mw-resource-name">
                <span>War3Net</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </span>
              <span class="mw-resource-detail">
                MPQ archives, SLK tables &amp; .w3x map formats
              </span>
            </a>
            <a
              href="https://github.com/yanghuan/CSharp.lua"
              class="mw-resource-row"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="mw-resource-name">
                <span>CSharp.lua</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </span>
              <span class="mw-resource-detail">Roslyn C# to Lua transpiler</span>
            </a>
          </div>
        </section>

        <section
          class="mw-panel mw-panel-compact"
          data-card="tools"
          aria-labelledby="panel-tools-title"
        >
          <header class="mw-card-head">
            <h2 id="panel-tools-title" class="mw-panel-subtitle">
              External Tools &amp; Hubs
            </h2>
            <div class="mw-card-corner">
              <span class="mw-panel-meta">Community</span>
            </div>
            <small class="mw-card-subtitle">
              Models, CASC extraction &amp; 3D studios
            </small>
          </header>
          <div class="mw-resource-list">
            <a
              href="https://www.hiveworkshop.com/"
              class="mw-resource-row"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="mw-resource-name">
                <span>Hive Workshop</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </span>
              <span class="mw-resource-detail">
                Models, icons, skins, maps &amp; modding forums
              </span>
            </a>
            <a
              href="http://www.zezula.net/en/casc/main.html"
              class="mw-resource-row"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="mw-resource-name">
                <span>CascView</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </span>
              <span class="mw-resource-detail">
                Browse &amp; extract Warcraft III CASC storage
              </span>
            </a>
            <a
              href="https://github.com/Retera/ReteraModelStudio"
              class="mw-resource-row"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="mw-resource-name">
                <span>Retera&apos;s Model Studio</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </span>
              <span class="mw-resource-detail">
                3D MDX/MDL model viewer &amp; animation editor
              </span>
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>

  <script is:inline>
    const copyBtn = document.querySelector("[data-copy-cli]");
    if (copyBtn) {
      const copyLabel = copyBtn.querySelector("[data-copy-label]");
      const commands = [
        "dotnet tool install -g Moonwell.Cli",
        "dotnet new install Moonwell.Templates",
        "dotnet new moonwell -n MyMap",
        "cd MyMap && moonwell build",
      ].join("\n");
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(commands);
          if (copyLabel) copyLabel.textContent = "Copied";
          setTimeout(() => {
            if (copyLabel) copyLabel.textContent = "Copy";
          }, 1800);
        } catch {
          // Ignore clipboard permission errors
        }
      });
    }
  </script>
</HomeLayout>
