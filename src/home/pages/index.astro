---
import { BookOpen, CodeXml, Compass, Rocket } from "@lucide/astro";
import HomeLayout from "../components/HomeLayout.astro";
---

<HomeLayout title="wc3.dev — Warcraft III: Reforged Modding, Moonwell & Tutorials">
  <main id="main-content" class="mw-home-main">
    <section class="mw-hero">
      <div class="mw-hero-copy">
        <h1 class="mw-hero-title">Warcraft III: Reforged Modding</h1>
        <p class="mw-hero-tagline">
          All-in-one modding framework for Warcraft III: Reforged — plus a step-by-step World Editor track for beginners
        </p>
        <div class="mw-hero-actions">
          <a href="/moonwell/" class="mw-btn mw-btn-primary">
            <CodeXml size={16} aria-hidden="true" />
            <span>Explore Moonwell</span>
          </a>
          <a href="/tutorials/" class="mw-btn mw-btn-secondary">
            <Compass size={16} aria-hidden="true" />
            <span>World Editor Tutorials</span>
          </a>
        </div>
      </div>
    </section>

    <section class="mw-pillars" aria-label="Modding Tracks">
      <article class="mw-pillar-card">
        <div class="mw-pillar-header">
          <span class="mw-pillar-eyebrow">
            <CodeXml size={15} aria-hidden="true" />
            <span>C# Framework &amp; Toolchain</span>
          </span>
          <h2 class="mw-pillar-title">Moonwell</h2>
          <p class="mw-pillar-description">
            Build Warcraft III maps in C#. Declare units, heroes, items, abilities, buffs, and upgrades in code, attach components and reactions to game events, and pack a playable <code>.w3x</code> with <code>moonwell build</code>.
          </p>
          <div class="mw-hero-actions">
            <a
              href="https://docs.wc3.dev/guides/getting-started/"
              class="mw-btn mw-btn-primary"
            >
              <Rocket size={16} aria-hidden="true" />
              <span>Get Started</span>
            </a>
            <a href="/moonwell/" class="mw-btn mw-btn-secondary">
              <BookOpen size={16} aria-hidden="true" />
              <span>Overview &amp; Docs</span>
            </a>
          </div>
        </div>
      </article>

      <article class="mw-pillar-card">
        <div class="mw-pillar-header">
          <span class="mw-pillar-eyebrow">
            <Compass size={15} aria-hidden="true" />
            <span>Beginner Track · 21 Lessons</span>
          </span>
          <h2 class="mw-pillar-title">World Editor Tutorials</h2>
          <p class="mw-pillar-description">
            New to Warcraft III map-making? Build a complete custom map, <strong>Defend the Village</strong>, from an empty grass field to a playable five-wave defense game using the World Editor — no programming required.
          </p>
          <div class="mw-hero-actions">
            <a
              href="/tutorials/editor-basics/install-and-open/"
              class="mw-btn mw-btn-primary"
            >
              <Compass size={16} aria-hidden="true" />
              <span>Start Lesson 1</span>
            </a>
            <a href="/tutorials/" class="mw-btn mw-btn-secondary">
              <BookOpen size={16} aria-hidden="true" />
              <span>All Chapters</span>
            </a>
          </div>
        </div>
      </article>
    </section>
  </main>
</HomeLayout>
