---
import {
  ArrowRight,
  BookOpen,
  Boxes,
  FolderOpen,
  Rocket,
  Sparkles,
  Terminal,
  Users,
  Workflow,
} from "@lucide/astro";
import HomeLayout from "../components/HomeLayout.astro";

const cards = [
  {
    title: "Getting Started",
    meta: "Guide",
    description: "Install the template and CLI, make a map, and run it in Warcraft III.",
    href: "https://docs.wc3.dev/guides/getting-started/",
    icon: Rocket,
  },
  {
    title: "Project & World Editor",
    meta: "Guide",
    description:
      "Project folders, map settings, custom assets, and saving built objects back to World Editor.",
    href: "https://docs.wc3.dev/guides/project-and-editor/",
    icon: FolderOpen,
  },
  {
    title: "Objects",
    meta: "Guide",
    description:
      "Declare units, heroes, items, abilities, buffs, destructables, doodads, and upgrades as C# classes.",
    href: "https://docs.wc3.dev/guides/objects/",
    icon: Boxes,
  },
  {
    title: "Actors, Components & Reactions",
    meta: "Guide",
    description:
      "Attach state and reaction hooks to units, items, destructables, players, and the game.",
    href: "https://docs.wc3.dev/guides/components-and-reactions/",
    icon: Workflow,
  },
  {
    title: "Abilities, Buffs & Timers",
    meta: "Guide",
    description:
      "React to casts, apply timed and ticking buffs, schedule timers, and manage ownership.",
    href: "https://docs.wc3.dev/guides/abilities-buffs-and-timers/",
    icon: Sparkles,
  },
  {
    title: "Multiplayer",
    meta: "Guide",
    description: "Run machine-local code with Local.For and catch desyncs as compile errors.",
    href: "https://docs.wc3.dev/guides/multiplayer/",
    icon: Users,
  },
  {
    title: "CLI & Build",
    meta: "Reference",
    description:
      "Commands, flags, build pipeline steps, development vs. release builds, and error logs.",
    href: "https://docs.wc3.dev/reference/cli-and-build/",
    icon: Terminal,
  },
  {
    title: "Runtime & Objects Reference",
    meta: "Reference",
    description:
      "All public types, properties, methods, reaction hooks, standard objects, and diagnostics.",
    href: "https://docs.wc3.dev/reference/runtime-api/",
    icon: BookOpen,
  },
];
---

<HomeLayout
  title="Moonwell — All-in-one modding framework for Warcraft III: Reforged"
  logo="moonwell"
  activeTab="moonwell"
>
  <main id="main-content" class="mw-home-main mw-dashboard-main">
    <section class="mw-s2f-card mw-moonwell-banner" aria-label="Moonwell Overview">
      <div class="mw-moonwell-banner-inner">
        <img
          src="/mw.gif"
          alt="A moonwell"
          width="96"
          height="96"
          class="mw-moonwell-sprite"
        />
        <div class="mw-moonwell-banner-copy">
          <div class="mw-moonwell-banner-head">
            <h1 class="mw-s2f-card-title">Moonwell</h1>
            <span class="mw-s2f-corner">
              <a
                href="https://docs.wc3.dev/guides/getting-started/"
                class="mw-s2f-btn mw-s2f-btn-primary"
              >
                <Rocket size={13} aria-hidden="true" />
                <span>get started</span>
              </a>
              <a href="https://docs.wc3.dev/" class="mw-s2f-btn">
                <BookOpen size={13} aria-hidden="true" />
                <span>docs</span>
                <ArrowRight size={13} aria-hidden="true" />
              </a>
            </span>
          </div>
          <p class="mw-moonwell-tagline">
            All-in-one modding framework for Warcraft III: Reforged
          </p>
          <p class="mw-s2f-fine">
            Declare units, abilities, buffs, and items as strongly-typed C# classes, react to
            events with components, and compile to Lua 5.3 + .w3x with <code>moonwell build</code>.
          </p>
        </div>
      </div>
    </section>

    <section class="mw-s2f-card" aria-label="Documentation">
      <header class="mw-s2f-card-head">
        <h2 class="mw-s2f-card-title">Moonwell Documentation</h2>
        <span class="mw-s2f-corner">
          <a href="https://docs.wc3.dev/" class="mw-s2f-btn">
            <span>open all</span>
            <ArrowRight size={13} aria-hidden="true" />
          </a>
        </span>
        <small class="mw-s2f-subtitle">
          Guides, CLI pipeline, runtime API, and compiler diagnostics
        </small>
      </header>
      <div class="mw-moonwell-grid">
        {
          cards.map((card, i) => {
            const Icon = card.icon;
            return (
              <a href={card.href} class="mw-moonwell-doc-card">
                <div class="mw-moonwell-doc-head">
                  <span class="mw-s2f-rank">{i + 1}</span>
                  <Icon size={15} class="mw-card-icon" aria-hidden="true" />
                  <span class="mw-moonwell-doc-title">{card.title}</span>
                  <span
                    class:list={[
                      "mw-s2f-val",
                      card.meta === "Guide" ? "mw-s2f-val-score" : "mw-s2f-val-info",
                    ]}
                  >
                    {card.meta}
                  </span>
                </div>
                <p class="mw-moonwell-doc-desc">{card.description}</p>
              </a>
            );
          })
        }
      </div>
    </section>
  </main>
</HomeLayout>
