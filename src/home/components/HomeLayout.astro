---
import "../../styles/global.css";

interface Props {
  title: string;
  description?: string;
  logo?: "wc3" | "moonwell";
}

const {
  title,
  description = "All-in-one modding framework for Warcraft III: Reforged.",
  logo = "wc3",
} = Astro.props;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="mw-home-body">
    <header class="header mw-home-header">
      <div class="mw-home-header-inner">
        <a href="https://wc3.dev/" class="site-title">
          {
            logo === "moonwell" ? (
              <img
                src="/mw-text-cropped.png"
                alt=""
                width="231"
                height="56"
                decoding="async"
              />
            ) : (
              <img
                src="/wc3-dev-logo.svg"
                alt=""
                width="136"
                height="32"
                decoding="async"
              />
            )
          }
          <span class="sr-only" translate="no">
            {logo === "moonwell" ? "Moonwell" : "wc3.dev"}
          </span>
        </a>
        <div class="mw-home-nav">
          <a href="/moonwell/" class="mw-home-nav-link">Moonwell</a>
          <a href="/tutorials/" class="mw-home-nav-link">Tutorials</a>
          <a href="/patch-notes/" class="mw-home-nav-link">Patch Notes</a>
          <a href="https://docs.wc3.dev/" class="mw-home-nav-link">Docs</a>
          <a href="https://docs.wc3.dev/reference/runtime-api/" class="mw-home-nav-link">
            Reference
          </a>
          <a
            href="https://github.com/mdlsvensson/moonwell"
            class="mw-home-github"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.44 9.81 8.21 11.4.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.85 1.24 1.85 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.6-2.8 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.3c0 .32.22.7.83.58A12 12 0 0 0 24 12C24 5.37 18.63 0 12 0Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </header>
    <slot />
    <footer class="mw-home-footer">
      <div class="mw-home-footer-inner">
        <p class="mw-home-footer-text">
          &copy; {currentYear} wc3.dev. Warcraft is &copy; Blizzard Entertainment, Inc.
        </p>
      </div>
    </footer>
  </body>
</html>
