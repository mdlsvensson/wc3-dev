{
  "name": "wc3-dev",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --config astro.docs.config.mjs",
    "dev:docs": "astro dev --config astro.docs.config.mjs",
    "dev:home": "astro dev --config astro.home.config.mjs",
    "dev:tutorials": "astro dev --config astro.tutorials.config.mjs",
    "build": "npm run build:home && npm run build:tutorials && npm run build:docs",
    "build:home": "astro build --config astro.home.config.mjs",
    "build:tutorials": "astro build --config astro.tutorials.config.mjs",
    "build:docs": "astro build --config astro.docs.config.mjs",
    "check": "astro check",
    "preview": "wrangler dev --config wrangler.jsonc",
    "preview:home": "wrangler dev --config wrangler.jsonc",
    "preview:docs": "wrangler dev --config wrangler.docs.jsonc",
    "dry-run": "npm run dry-run:home && npm run dry-run:docs",
    "dry-run:home": "wrangler deploy --dry-run --config wrangler.jsonc",
    "dry-run:docs": "wrangler deploy --dry-run --config wrangler.docs.jsonc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test tests/build.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.37.0",
    "@astrojs/starlight-tailwind": "^4.0.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@lucide/astro": "^1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.16.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^2.5.15",
    "typescript": "^5.9.0",
    "wrangler": "^4.14.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.35.5": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
