{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:astro dev --host 127.0.0.1",
    "check": "deno run -A npm:astro check",
    "build": "deno run -A npm:astro build --force",
    "preview": "deno run -A npm:astro preview --host 127.0.0.1",
    "build:test": "RESOURCE_FIXTURES=1 ASSET_BASE_URL=https://assets.example.test/ deno task build",
    "fixtures:store": "deno run -A scripts/resources/fixture-store.ts",
    "build:fixtures": "RESOURCE_FIXTURES=1 ASSET_BASE_URL=http://127.0.0.1:4322/ deno task build",
    "test": "deno task build:test && deno test -A scripts/",
    "test:unit": "deno test -A scripts/shell_test.ts scripts/resources/ scripts/previewers/ scripts/tutorials/ scripts/hive/",
    "resource:add": "deno run -A scripts/resources/add.ts",
    "resource:check": "deno run -A scripts/resources/check.ts",
    "tutorial:check": "deno run -A scripts/tutorials/check.ts",
    "hive:import": "deno run --allow-read --allow-write=src/data/hive-activity.json --allow-env=INIT_CWD scripts/hive/import.ts",
    "game:sync": "deno run -A scripts/resources/game-sync.ts",
    "assets:serve": "mkdir -p .asset-store && deno run --allow-net --allow-read jsr:@std/http@^1/file-server .asset-store --host 127.0.0.1 --port 4322 --cors --no-dir-listing"
  },
  "fmt": { "exclude": ["node_modules", "dist", ".astro", "deno.lock"] }
}
