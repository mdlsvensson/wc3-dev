{
  "workspace": ["./home", "./docs", "./shared"],
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": ["**/*.md"]
  },
  "tasks": {
    "dev": "deno task --cwd docs dev --port 5173",
    "dev:home": "deno task --cwd home dev --port 5174",
    "content": "deno run --frozen --allow-env=VSCODE_TEXTMATE_DEBUG --allow-read --allow-write=docs/generated tools/content/prepare.ts",
    "test": "deno test --frozen --allow-env=VSCODE_TEXTMATE_DEBUG,PATH,DENO_DEPLOYMENT_ID,GITHUB_SHA,CI_COMMIT_SHA --allow-read --allow-write --allow-run=git,sh tests/",
    "test:preview": "deno test --frozen --allow-read --allow-net tests/preview_test.ts -- http://localhost:5173 http://localhost:5174",
    "build:docs": "deno task --cwd docs build",
    "build:home": "deno task --cwd home build",
    "build": "deno task build:docs && deno task build:home",
    "check": "deno run --frozen --allow-env=VSCODE_TEXTMATE_DEBUG --allow-read --allow-write=docs/generated --allow-run=deno tools/check.ts",
    "preview:docs": "deno task wrangler dev --config docs/_fresh/server/wrangler.json --port 5173 --inspector-port 0 --persist-to docs/.wrangler/state --local",
    "preview:home": "deno task wrangler dev --config home/_fresh/server/wrangler.json --port 5174 --inspector-port 0 --persist-to home/.wrangler/state --local",
    "dry-run:docs": "deno task wrangler deploy --dry-run --config docs/_fresh/server/wrangler.json --outdir docs/.wrangler/dry-run",
    "dry-run:home": "deno task wrangler deploy --dry-run --config home/_fresh/server/wrangler.json --outdir home/.wrangler/dry-run",
    "wrangler": "deno run -A --frozen npm:wrangler@4.149.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["dom", "dom.iterable", "deno.ns"]
  },
  "imports": {
    "fresh": "jsr:@fresh/core@2.3.3",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@1.1.2",
    "vite": "npm:vite@7.3.7",
    "vite/": "npm:vite@7.3.7/",
    "preact": "npm:preact@10.29.8",
    "preact/": "npm:preact@10.29.8/",
    "preact/jsx-runtime": "npm:preact@10.29.8/jsx-runtime",
    "preact/jsx-dev-runtime": "npm:preact@10.29.8/jsx-dev-runtime",
    "preact/hooks": "npm:preact@10.29.8/hooks",
    "@preact/signals": "npm:@preact/signals@2.11.3",
    "@cloudflare/vite-plugin": "npm:@cloudflare/vite-plugin@1.63.1",
    "wrangler": "npm:wrangler@4.149.0",
    "markdown-it": "npm:markdown-it@14.1.1",
    "@types/markdown-it": "npm:@types/markdown-it@14.2.0",
    "@types/babel__core": "npm:@types/babel__core@7.20.5",
    "shiki": "npm:shiki@4.5.0",
    "shiki/core": "npm:shiki@4.5.0/core",
    "shiki/engine/javascript": "npm:shiki@4.5.0/engine/javascript",
    "shiki/langs/lua.mjs": "npm:shiki@4.5.0/langs/lua.mjs",
    "shiki/themes/github-dark.mjs": "npm:shiki@4.5.0/themes/github-dark.mjs",
    "minisearch": "npm:minisearch@7.2.0",
    "@std/assert": "jsr:@std/assert@1.0.19"
  }
}
